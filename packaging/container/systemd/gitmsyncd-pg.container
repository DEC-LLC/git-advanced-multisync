[Unit]
Description=gitmsyncd-pg PostgreSQL 16 (sidecar in gitmsyncd netns)
Requires=gitmsyncd.service
BindsTo=gitmsyncd.service
After=gitmsyncd.service

[Container]
Image=docker.io/library/postgres:16-alpine
ContainerName=gitmsyncd-pg
Network=container:gitmsyncd
Volume=gitmsyncd_pgdata:/var/lib/postgresql/data
EnvironmentFile=/etc/gitmsyncd-pg/env

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
