# gitmsyncd runtime env — copy to /etc/gitmsyncd/env on the host, fill real values.
# Secrets sourced from vtb-credentials-vault at deploy time; NEVER commit real values.

# --- PG connection (points at OVS-attached DNS name of the sibling gitmsyncd-pg container) ---
GITMSYNCD_DSN=dbi:Pg:dbname=gitmsyncd;host=gitmsyncd-pg-server3.decllc.biz;port=5432
GITMSYNCD_DB_USER=gitmsyncd
GITMSYNCD_DB_PASS=<FILL_FROM_VAULT>

# --- HTTP listen (fronted by caddy-tls for step-ca TLS) ---
GITMSYNCD_LISTEN=http://0.0.0.0:9097
GITMSYNCD_SECRET=<FILL_FROM_VAULT_random_64_hex>

# --- Working dir (bare-repo mirror cache lives here; volume-mounted from gitmsyncd_workdir) ---
GITMSYNCD_WORKDIR=/var/lib/gitmsyncd/workdir

# --- Resource governance (from OG contract + Containerfile defaults) ---
GITMSYNCD_MAX_FORKS=4
GITMSYNCD_MAX_LOAD=3.2
GITMSYNCD_MIN_MEM_MB=256
GITMSYNCD_MIN_DISK_MB=1024

# --- Worker set assigned by Fleet (default if standalone) ---
GITMSYNCD_WORKER_SET=default
